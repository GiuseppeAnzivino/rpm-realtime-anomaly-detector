#!/usr/bin/env python3
import sys
from subprocess import check_output

commit_msg_filepath = sys.argv[1]
commit_source = sys.argv[2] if len(sys.argv) > 2 else ""

# Skip template injection on merge, squash, or --amend commits
if commit_source in ("merge", "squash", "commit"):
    sys.exit(0)

try:
    branch = check_output(["git", "symbolic-ref", "--short", "HEAD"]).decode("utf-8").strip()
except Exception:
    branch = "unknown"

# 1. Determine commit type from branch prefix (docs & ci are committed on main as 'chore')
PREFIX_MAP = {
    "feature/": "feature",
    "fix/": "fix",
    "refactor/": "refactor",
    "test/": "test",
}

ctype = "chore"
for prefix, mapped_type in PREFIX_MAP.items():
    if branch.startswith(prefix):
        ctype = mapped_type
        break

# 2. Extract scope from branch path: prefix/<microservice-name>/<layer>
# Example: feature/ingestion/backend -> scope = ingestion/backend
scope = "repo"
if "/" in branch and branch not in ("main", "master"):
    slug = branch.split("/", 1)[1].strip().lower()
    if slug:
        scope = slug

template = f"""{ctype}({scope}): <concise summary>

ADDED:
- <list new features, docs, or files created>

CHANGED:
- <list modifications or fixes (or write 'None')>
"""

with open(commit_msg_filepath, "r+", encoding="utf-8") as f:
    content = f.read()
    f.seek(0, 0)
    f.write(template + "\n" + content)